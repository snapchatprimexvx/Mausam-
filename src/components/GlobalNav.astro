---
// src/components/GlobalNav.astro
---
<nav class="sticky top-0 z-50 h-11 w-full bg-surface-black text-[12px] font-normal tracking-[-0.01em] text-body-on-dark flex items-center justify-between px-4 sm:px-6 border-b border-white/[0.08]" id="global-nav">
  <!-- Left Side: Brand Logo -->
  <div class="flex items-center gap-2 sm:gap-6 shrink-0">
    <a href="/" class="flex items-center gap-2 hover:opacity-80 transition-opacity active-scale">
      <svg class="w-4.5 h-4.5 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M17.5 19A3.5 3.5 0 0 0 21 15.5c0-2.79-2.54-4.5-5-4.5-.47 0-.89.09-1.3.27A5 5 0 0 0 5 14c0 2.76 2.24 5 5 5h7.5z" />
        <path d="M12 2v2M4.93 4.93l1.41 1.41M20 12h2M17.66 6.34l1.41-1.41" />
      </svg>
      <span class="font-semibold text-white tracking-apple-tight text-sm uppercase">Mausam</span>
    </a>
  </div>

  <!-- Right Side: Language Toggle -->
  <div class="flex items-center gap-2 sm:gap-3 shrink-0">
    <button id="lang-toggle-btn" class="px-2.5 sm:px-3 py-1 bg-white text-ink text-[11px] sm:text-xs font-medium rounded-md hover:bg-gray-100 transition-colors active-scale cursor-pointer whitespace-nowrap" data-i18n="lang.toggle">
      English → Hindi
    </button>
  </div>
</nav>
