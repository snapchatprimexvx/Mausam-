---
// src/components/SubNav.astro
---
<div class="sticky top-11 z-40 h-13 w-full bg-canvas-parchment/80 backdrop-blur-md flex items-center justify-between px-6 border-b border-hairline" id="sub-nav-frosted">
  <!-- Left Side: Section Category & Selected City -->
  <div class="flex items-center gap-3">
    <span class="text-[21px] font-semibold tracking-apple-tight text-ink">Dashboard</span>
    <span class="h-4 w-[1px] bg-hairline hidden sm:block"></span>
    <span class="text-sm font-normal text-ink-muted-48 hidden sm:block" id="sub-nav-city-display">Mumbai, India</span>
  </div>

  <!-- Right Side: Location Selector Styled as a Search Pill -->
  <div class="flex items-center gap-4">
    <!-- Location Search Pill -->
    <div class="relative active-scale" id="location-search-container">
      <div class="absolute left-4 top-1/2 -translate-y-1/2 text-ink-muted-48 pointer-events-none">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path d="M12 2a8 8 0 0 0-8 8c0 5.25 8 12 8 12s8-6.75 8-12a8 8 0 0 0-8-8z"></path>
          <circle cx="12" cy="10" r="3"></circle>
        </svg>
      </div>
      <input
        type="text"
        id="location-search-input"
        placeholder="Search location..."
        autocomplete="off"
        class="h-9 pl-10 pr-4 bg-canvas text-ink text-sm font-normal border border-black/[0.08] rounded-pill focus:outline-none focus:ring-2 focus:ring-primary-focus tracking-apple-tight w-[200px] transition-all duration-200"
      />
      <!-- Search Results Dropdown -->
      <div id="location-search-results" class="fixed bg-canvas border border-hairline rounded-lg shadow-lg hidden max-h-[320px] overflow-y-auto" style="z-index: 9999;"></div>
    </div>

    <!-- Right Side CTA: Live Radar Pill Button -->
    <button class="hidden xs:block px-4 py-1.5 bg-primary text-white text-xs font-normal rounded-pill hover:bg-primary-focus transition-colors active-scale cursor-pointer">
      Live Radar
    </button>
  </div>
</div>
