---
// src/components/SubNav.astro
---
<div class="sticky top-11 z-40 w-full bg-white border-b border-hairline shadow-sm" id="sub-nav-frosted">
  <div class="max-w-[1440px] mx-auto px-4 sm:px-6 py-3 sm:py-4">
    <div class="flex flex-col sm:flex-row sm:items-center gap-3 sm:gap-4">
      
      <!-- Left: Dashboard Heading -->
      <h1 class="text-xl sm:text-2xl font-semibold text-ink tracking-apple-tight shrink-0" data-i18n="dashboard.title">Dashboard</h1>

      <!-- Right: Location Box + Current Location Button -->
      <div class="flex items-center gap-2 sm:gap-3 flex-1 min-w-0">
        <!-- Location Search Box -->
        <div class="relative flex-1 min-w-0" id="location-search-container" style="overflow: visible;">
          <div class="absolute left-3 top-1/2 -translate-y-1/2 text-ink-muted-48 pointer-events-none">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path d="M12 2a8 8 0 0 0-8 8c0 5.25 8 12 8 12s8-6.75 8-12a8 8 0 0 0-8-8z"></path>
              <circle cx="12" cy="10" r="3"></circle>
            </svg>
          </div>
          <input
            type="text"
            id="location-search-input"
            placeholder="Search location..."
            data-i18n="dashboard.searchPlaceholder"
            autocomplete="off"
            class="h-10 sm:h-11 pl-9 pr-4 bg-canvas text-ink text-sm font-normal border border-black/[0.08] rounded-xl focus:outline-none focus:ring-2 focus:ring-primary-focus tracking-apple-tight w-full transition-all duration-200"
          />
          <!-- Search Results Dropdown -->
          <div id="location-search-results" class="absolute left-0 top-full mt-1 bg-canvas border border-hairline rounded-lg shadow-lg hidden max-h-[320px] overflow-y-auto z-[9999]" style="min-width: 260px; max-width: calc(100vw - 2rem);"></div>
        </div>

        <!-- Use My Current Location Button -->
        <button id="use-my-location-btn" class="px-3 sm:px-4 py-2 sm:py-2.5 bg-canvas text-ink text-xs sm:text-sm font-medium border border-black/[0.08] rounded-xl hover:border-primary/50 hover:bg-surface-pearl transition-colors active-scale cursor-pointer flex items-center gap-1.5 sm:gap-2 whitespace-nowrap shrink-0" title="Use my current location" data-i18n-aria="dashboard.currentLocation">
          <svg class="w-4 h-4 shrink-0 text-primary" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <circle cx="12" cy="12" r="3"></circle>
            <path d="M12 2v4m0 12v4M2 12h4m12 0h4"></path>
          </svg>
          <span id="use-my-location-text" data-i18n="dashboard.currentLocation">Current Location</span>
        </button>

        <!-- Live Radar Pill Button -->
        <button class="hidden sm:inline-flex px-4 py-2.5 bg-primary text-white text-xs sm:text-sm font-medium rounded-xl hover:bg-primary-focus transition-colors active-scale cursor-pointer shrink-0" data-i18n="dashboard.liveRadar">
          Live Radar
        </button>
      </div>
    </div>
  </div>
</div>
