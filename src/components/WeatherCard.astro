---
// src/components/WeatherCard.astro
interface Props {
  id?: string;
  title: string;
  value: string | number;
  desc?: string;
  accentClass?: string;
  titleKey?: string;
}

const { id, title, value, desc, accentClass = "", titleKey } = Astro.props;
---
<div id={id} class="bg-canvas border border-hairline rounded-lg p-4 sm:p-6 flex flex-col justify-between min-h-[120px] sm:min-h-[140px] hover:border-primary/30 transition-colors active-scale">
  <div class="min-w-0">
    <!-- Card Heading (SF Pro Text 14px / 600) -->
    <h3 class="text-[10px] sm:text-xs font-semibold text-ink-muted-48 uppercase tracking-wider mb-1.5 sm:mb-2" {...titleKey ? { 'data-i18n': titleKey } : {}}>{title}</h3>
    
    <!-- Card Value (SF Pro Display 28px / 400) -->
    <div data-card-value class={`text-xl sm:text-[28px] font-normal tracking-apple-tight text-ink leading-none ${accentClass} break-words`}>
      {value}
    </div>
  </div>
  
  <!-- Optional Description (SF Pro Text 14px / 400) -->
  {desc && (
    <p class="text-xs sm:text-sm text-ink-muted-80 font-normal leading-tight mt-2 sm:mt-3 border-t border-hairline pt-2 break-words">
      {desc}
    </p>
  )}
</div>
