---
// src/components/WeatherCard.astro
interface Props {
  id?: string;
  title: string;
  value: string | number;
  desc?: string;
  accentClass?: string;
}

const { id, title, value, desc, accentClass = "" } = Astro.props;
---
<div id={id} class="bg-canvas border border-hairline rounded-lg p-6 flex flex-col justify-between min-h-[140px] hover:border-primary/30 transition-colors active-scale">
  <div>
    <!-- Card Heading (SF Pro Text 14px / 600) -->
    <h3 class="text-xs font-semibold text-ink-muted-48 uppercase tracking-wider mb-2">{title}</h3>
    
    <!-- Card Value (SF Pro Display 28px / 400) -->
    <div class={`text-[28px] font-normal tracking-apple-tight text-ink leading-none ${accentClass}`}>
      {value}
    </div>
  </div>
  
  <!-- Optional Description (SF Pro Text 14px / 400) -->
  {desc && (
    <p class="text-sm text-ink-muted-80 font-normal leading-tight mt-3 border-t border-hairline pt-2">
      {desc}
    </p>
  )}
</div>
